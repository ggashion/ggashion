# Kopioi tämä tiedosto nimelle config.env (install.sh tekee sen automaattisesti)
# ja täytä arvot. config.env EI mene GitHubiin.
#
# Arvoihin viitataan config.js:ssä muodossa ${NIMI}.

# Tämän repon sijainti Pi:llä (install.sh asettaa automaattisesti)
MIRROR_DIR=/home/pi/ggashion

# Digitransit API -avain, ilmainen: https://portal-api.digitransit.fi
HSL_APIKEY=

# Ambient Weather -sääasema: https://ambientweather.net -> Account -> API Keys
AMBIENT_APIKEY=
AMBIENT_APPKEY=
# Aseman MAC-osoite (voi jättää tyhjäksi, jos tilillä on vain yksi asema)
AMBIENT_MAC=

# Näytön HDMI-lähtö ja kierto (pystynäyttö: 90 tai 270, riippuu näytön asennosta)
MM_SCREEN_OUTPUT=HDMI-A-1
MM_SCREEN_TRANSFORM=90

# Liiketunnistimen GPIO-numero (GPIO23 = fyysinen pinni 16)
MM_PIR_GPIO=23
MM_PIR_CHIP=gpiochip0
